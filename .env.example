# ==========================================
# Agent 365: Microsoft 365 Suite Configuration
# ==========================================

# Execution Mode: 'mock' (instant offline sandbox) or 'live' (Microsoft Graph API)
M365_MODE=mock

# Microsoft Entra ID (Azure AD) Credentials (Required only for 'live' mode)
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
M365_USER_EMAIL=user@yourdomain.onmicrosoft.com

# LLM Configuration
# Providers: 'heuristic' (built-in autonomous engine), 'openai', 'gemini', 'azure_openai'
LLM_PROVIDER=heuristic
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
